+    public void applyUsbBandwidth(int wantBytes) {
+        String port = usbPort();
+        usbReset("USB bandwidth allocation changed to " + wantBytes + " bytes per microframe", false);
+        long deadline = System.nanoTime() + 6_000_000_000L;
+        int now = -1;
