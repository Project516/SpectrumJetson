+        int mode = (int) ((word >>> 56) & 3);
+        return new NtControlWord(
+                ((word >>> 58) & 1) != 0,
+                mode == 1,
+                mode == 3,
+                ((word >>> 59) & 1) != 0,
+                ((word >>> 60) & 1) != 0,
+                ((word >>> 61) & 1) != 0);
