+    /**
+     * SpectrumJetson: the camera's delay from the end of exposure to its first USB packet
+     * (sensor readout + JPEG start), in microseconds. Not visible from here; measure it on the
+     * robot (spin in front of a tag) and set SPECTRUM_CAMERA_DELAY_US. Default 0.
+     */
+    private static final long CAMERA_DELAY_US = envLong("SPECTRUM_CAMERA_DELAY_US", 0);
+
+    private static long envLong(String name, long fallback) {
+        try {
+            String v = System.getenv(name);
+            return v == null || v.isBlank() ? fallback : Long.parseLong(v.trim());
+        } catch (NumberFormatException e) {
+            return fallback;
+        }
+    }
+
+    private boolean loggedMidExposure = false;
+
+    /**
+     * SpectrumJetson: move a frame's timestamp to mid-exposure. uvcvideo stamps a frame when its
+     * first USB packet arrives, which is after the whole exposure and the camera's internal delay.
+     * Robot code fuses the pose at this time, so a late stamp shows up as error while turning
+     * (2.5 ms at 360 deg/s is ~1 degree). The exposure is known exactly here and changes when
+     * it's retuned, so it's corrected here rather than as a constant on the robot. Only the
+     * published time moves; {@code lastTime} keeps the driver's time for "newest frame" checks.
+     */
+    private long toMidExposureUs(long captureTimeUs) {
+        if (captureTimeUs == 0) return 0;
+        double exposureUs = settables.getExposureTimeUs();
+        if (exposureUs <= 0) return captureTimeUs - CAMERA_DELAY_US;
+        long shift = (long) (exposureUs / 2) + CAMERA_DELAY_US;
+        if (!loggedMidExposure) {
+            loggedMidExposure = true;
+            logger.info(
+                    "Frame timestamps moved "
+                            + shift / 1000.0
+                            + " ms earlier, to mid-exposure (exposure "
+                            + exposureUs / 1000.0
+                            + " ms, camera delay "
+                            + CAMERA_DELAY_US / 1000.0
+                            + " ms)");
+        }
+        return captureTimeUs - shift;
+    }
