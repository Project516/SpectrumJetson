+    // SpectrumJetson Rewind. POST body, all optional:
+    // {"manual": true|false, "fps": 30, "quotaGB": 100, "minFreeGB": 15, "delete": "<session>"}
+    private record RewindRequest(
+            Boolean manual, Double fps, Double quotaGB, Double minFreeGB, String delete) {}
+
+    public static void onRewindStatusRequest(Context ctx) {
+        try {
+            ctx.status(200);
+            ctx.result(kObjectMapper.writeValueAsString(RewindManager.getInstance().status()));
+            ctx.contentType("application/json");
+        } catch (JsonProcessingException e) {
+            ctx.status(500);
+            ctx.result("Could not read Rewind status");
+        }
+    }
+
+    public static void onRewindSetRequest(Context ctx) {
+        try {
+            var req = kObjectMapper.readValue(ctx.body(), RewindRequest.class);
+            var rm = RewindManager.getInstance();
+            if (req.fps() != null || req.quotaGB() != null || req.minFreeGB() != null) {
+                rm.updateSettings(req.fps(), req.quotaGB(), req.minFreeGB());
+            }
+            if (req.manual() != null) rm.setManual(req.manual());
+            if (req.delete() != null && !rm.deleteSession(req.delete())) {
+                ctx.status(400);
+                ctx.result("Cannot delete that session (unknown, or still recording)");
+                return;
+            }
+            ctx.status(200);
+            ctx.result(kObjectMapper.writeValueAsString(rm.status()));
+            ctx.contentType("application/json");
+        } catch (IOException e) {
+            ctx.status(400);
+            ctx.result(
+                    "Expected {\"manual\": true|false, \"fps\": n, \"quotaGB\": n, \"minFreeGB\": n, \"delete\": name}");
+        }
+    }
+
+    /** GET /api/rewind/download?session=NAME: the recording as a zip of AVIs, built as it streams. */
+    public static void onRewindDownloadRequest(Context ctx) {
+        String name = ctx.queryParam("session");
+        var dir = RewindManager.sessionDir(name);
+        if (dir == null) {
+            ctx.status(404);
+            ctx.result("No such recording");
+            return;
+        }
+        logger.info("Rewind: sending recording " + name + " to " + ctx.ip());
+        ctx.contentType("application/zip");
+        ctx.header("Content-Disposition", "attachment; filename=\"" + name + ".zip\"");
+        // A match is ~1 GB: run the copy below the vision threads' priority.
+        RewindManager.setThreadNice(10, logger);
+        try {
+            org.photonvision.rewind.RewindExport.writeZip(dir, ctx.outputStream());
+        } catch (IOException e) {
+            logger.warn("Rewind: download of " + name + " stopped: " + e.getMessage());
+        } finally {
+            RewindManager.setThreadNice(0, logger);
+        }
+    }
+
