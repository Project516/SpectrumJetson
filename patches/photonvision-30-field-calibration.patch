diff --git a/photon-client/src/components/fieldcal/CameraTuneCard.vue b/photon-client/src/components/fieldcal/CameraTuneCard.vue
new file mode 100644
index 00000000..cecf8bb9
--- /dev/null
+++ b/photon-client/src/components/fieldcal/CameraTuneCard.vue
@@ -0,0 +1,258 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-30): one camera in the field-calibration settings step. Its stream,
+// the tags it sees right now, sliders to set each control by hand (saved to the pipeline in use,
+// like the Input tab), a lock per control that the tuner leaves alone, and its own Tune / Apply.
+import { computed, ref, watch } from "vue";
+import PhotonCameraStream from "@/components/app/photon-camera-stream.vue";
+import { useCameraSettingsStore } from "@/stores/settings/CameraSettingsStore";
+import type { Control, TuneCamera } from "@/types/FieldCalTypes";
+
+const props = defineProps<{
+  name: string;
+  controls?: Record<string, Control | number | boolean>;
+  preview?: { margins: Record<string, number>; ageMs: number };
+  tune?: TuneCamera;
+  locks?: string[];
+  tuningRunning: boolean;
+  phase: string;
+  progress: number;
+  disabled: boolean;
+  act: (body: object, done?: string) => Promise<void>;
+}>();
+
+const ORDER = ["exposure", "gain", "brightness", "contrast", "gamma", "sharpness", "backlight"];
+const LABEL: Record<string, string> = {
+  exposure: "Exposure",
+  gain: "Gain",
+  brightness: "Brightness",
+  contrast: "Contrast",
+  gamma: "Gamma",
+  sharpness: "Sharpness",
+  backlight: "Backlight comp."
+};
+const HINT: Record<string, string> = {
+  exposure: "Shorter means less motion blur. Set it first.",
+  gain: "Brightens without longer exposure, but adds noise.",
+  brightness: "An offset on every pixel.",
+  contrast: "The camera's contrast curve.",
+  gamma: "Brightens the darks.",
+  sharpness: "The camera's edge sharpening; too much puts halos on tag edges.",
+  backlight: "Brightens for bright backgrounds. Usually off for tags."
+};
+
+const ctl = computed(() =>
+  ORDER.filter((k) => typeof props.controls?.[k] === "object").map((k) => ({
+    key: k,
+    ...(props.controls![k] as Control)
+  }))
+);
+const pipelineIndex = computed(() => props.controls?.pipelineIndex as number | undefined);
+const autoExposure = computed(() => props.controls?.autoExposure === true);
+
+// What the camera sees right now (the page's preview, a few times a second).
+const seen = computed(() =>
+  props.preview && props.preview.ageMs < 2000
+    ? Object.entries(props.preview.margins).map(([id, m]) => ({ id: Number(id), margin: m }))
+    : []
+);
+const fresh = computed(() => !!props.preview && props.preview.ageMs < 2000);
+
+// Locks live on the Jetson (every browser sees the same ones, and the tuner uses them).
+const locked = computed(() => new Set(props.locks ?? []));
+const toggleLock = (k: string) =>
+  props.act({ action: "setLock", camera: props.name, control: k, on: !locked.value.has(k) });
+
+// A control keeps its dragged value until the change has been saved (the status poll mustn't
+// snap the slider back mid-drag).
+const drag = ref<Record<string, number>>({});
+const toSlider = (k: string, v: number) => (k === "exposure" ? Math.log10(Math.max(1, v)) : v);
+const fromSlider = (k: string, s: number) => (k === "exposure" ? Math.round(10 ** s) : Math.round(s));
+const sliderValue = (c: { key: string; value: number }) => drag.value[c.key] ?? toSlider(c.key, c.value);
+const shown = (c: { key: string; value: number }) => fromSlider(c.key, sliderValue(c));
+const fmt = (k: string, v: number) => (k === "exposure" ? `${v} (${(v / 10).toFixed(1)} ms)` : String(v));
+const forget = (k: string) => {
+  const d = { ...drag.value };
+  delete d[k];
+  drag.value = d;
+};
+const setControl = async (k: string, s: number) => {
+  await props.act({ action: "setControl", camera: props.name, control: k, value: fromSlider(k, s) });
+  setTimeout(() => forget(k), 3000); // in case the camera never reports exactly that value
+};
+// Let go of a dragged value once the camera reports it.
+watch(
+  () => props.controls,
+  (cs) => {
+    for (const k of Object.keys(drag.value)) {
+      const c = cs?.[k];
+      if (typeof c === "object" && Math.abs(c.value - fromSlider(k, drag.value[k])) < 1) forget(k);
+    }
+  }
+);
+// Controls the pipeline can leave at the camera's own default (-1).
+const HAS_DEFAULT = new Set(["contrast", "gamma", "sharpness", "backlight"]);
+const resetControl = (k: string) =>
+  props.act({ action: "setControl", camera: props.name, control: k, value: -1 }, `${LABEL[k]}: camera default`);
+
+const busyHere = computed(() => props.tuningRunning && !!props.tune?.tuning);
+const hasRecommendations = computed(
+  () =>
+    !!props.tune &&
+    !props.tune.tuning &&
+    Object.entries(props.tune.recommended).some(([k, v]) => v !== props.tune!.startValues[k])
+);
+const tried = (k: string) => (props.tune?.results ?? []).filter((r) => r.control === k);
+const startTune = () => props.act({ action: "tune", camera: props.name });
+
+const cameraSettings = computed(() =>
+  Object.values(useCameraSettingsStore().cameras).find((c) => c.nickname === props.name)
+);
+const showStream = ref(true);
+</script>
+
+<template>
+  <v-card variant="outlined" class="pa-3 h-100">
+    <div class="d-flex align-center flex-wrap" style="gap: 8px">
+      <span class="text-h6">{{ name }}</span>
+      <v-chip v-if="pipelineIndex !== undefined" size="small">pipeline {{ pipelineIndex }}</v-chip>
+      <v-chip v-if="!fresh" size="small" color="grey">no recent frames</v-chip>
+      <v-chip v-else-if="seen.length" size="small" color="success">
+        sees {{ seen.map((s) => `${s.id} (${s.margin})`).join(", ") }}
+      </v-chip>
+      <v-chip v-else size="small" color="warning">sees no tags: turn the robot</v-chip>
+      <v-spacer />
+      <v-btn
+        size="x-small"
+        variant="text"
+        :icon="showStream ? 'mdi-eye-off' : 'mdi-eye'"
+        @click="showStream = !showStream"
+      />
+    </div>
+
+    <photon-camera-stream
+      v-if="showStream && cameraSettings"
+      :id="`fieldcal-stream-${name}`"
+      :camera-settings="cameraSettings"
+      stream-type="Processed"
+      class="mt-2 mx-auto"
+      style="width: 100%; max-width: 560px; height: auto; display: block"
+    />
+
+    <div class="d-flex align-center flex-wrap mt-3" style="gap: 8px">
+      <v-btn
+        v-if="!busyHere"
+        color="primary"
+        size="small"
+        prepend-icon="mdi-tune"
+        :disabled="disabled || tuningRunning || !seen.length"
+        @click="startTune"
+        >Tune {{ name }}</v-btn
+      >
+      <template v-else>
+        <span class="text-caption">{{ phase }}</span>
+        <v-progress-linear :model-value="progress" color="primary" height="6" style="max-width: 160px" />
+        <v-btn size="x-small" variant="tonal" @click="act({ action: 'cancelTune' })">Stop</v-btn>
+      </template>
+      <v-btn
+        v-if="hasRecommendations"
+        size="small"
+        color="success"
+        prepend-icon="mdi-content-save"
+        :disabled="disabled || tuningRunning"
+        @click="act({ action: 'applyTuning', camera: name }, `Saved ${name}'s recommended settings`)"
+        >Apply recommended</v-btn
+      >
+      <span v-if="tune?.outcome && !busyHere" class="text-caption">{{ tune.outcome }}</span>
+    </div>
+    <div v-if="tune?.baseline && tune.baselineTags.length && !busyHere" class="text-caption mt-1">
+      Measured on tags {{ tune.baselineTags.join(", ") }}: margin {{ Math.round(tune.baseline.margin) }}, jitter
+      {{ tune.baseline.jitterPx.toFixed(2) }} px at the start.
+    </div>
+    <v-alert v-if="autoExposure" density="compact" variant="tonal" color="warning" class="mt-2">
+      Auto exposure is on for this pipeline: setting exposure here (or tuning it) turns it off.
+    </v-alert>
+
+    <v-table density="compact" class="mt-2 controls">
+      <thead>
+        <tr>
+          <th title="Locked settings are left as they are when tuning">
+            <v-icon size="small">mdi-lock</v-icon>
+          </th>
+          <th>Setting</th>
+          <th style="min-width: 150px"></th>
+          <th>Now</th>
+          <th>Tuned</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr v-for="c in ctl" :key="c.key">
+          <td>
+            <v-checkbox-btn
+              :model-value="locked.has(c.key)"
+              density="compact"
+              :disabled="busyHere"
+              @update:model-value="toggleLock(c.key)"
+            />
+          </td>
+          <td :title="HINT[c.key]">{{ LABEL[c.key] }}</td>
+          <td>
+            <v-slider
+              :model-value="sliderValue(c)"
+              :min="toSlider(c.key, c.min)"
+              :max="toSlider(c.key, c.max)"
+              :step="c.key === 'exposure' ? 0.01 : 1"
+              density="compact"
+              hide-details
+              :disabled="disabled || busyHere"
+              @update:model-value="(v: number) => (drag = { ...drag, [c.key]: v })"
+              @end="(v: number) => setControl(c.key, v)"
+            />
+          </td>
+          <td class="text-no-wrap">
+            {{ fmt(c.key, shown(c)) }}
+            <v-btn
+              v-if="HAS_DEFAULT.has(c.key)"
+              size="x-small"
+              variant="text"
+              icon="mdi-restore"
+              :title="`Camera default (${c.default})`"
+              :disabled="disabled || busyHere"
+              @click="resetControl(c.key)"
+            />
+          </td>
+          <td class="text-caption">
+            <template v-if="tune && tune.recommended[c.key] !== undefined">
+              <b v-if="tune.recommended[c.key] !== tune.startValues[c.key]">{{
+                fmt(c.key, tune.recommended[c.key])
+              }}</b>
+              <span v-else>keep</span>
+            </template>
+            <span v-else-if="tune?.locked?.includes(c.key)">locked when tuned</span>
+            <span v-if="tune?.notes[c.key]"> ({{ tune.notes[c.key] }})</span>
+            <div v-if="tried(c.key).length" class="tried">
+              {{
+                tried(c.key)
+                  .map((r) => `${r.value}: ${Math.round(100 * r.found)}%/${Math.round(r.margin)}`)
+                  .join("  ")
+              }}
+            </div>
+          </td>
+        </tr>
+      </tbody>
+    </v-table>
+    <div class="text-caption mt-1">
+      Tried: value: tags found / decision margin. Changes here save to pipeline {{ pipelineIndex }}, like the Camera
+      page's Input tab.
+    </div>
+  </v-card>
+</template>
+
+<style scoped>
+.controls td {
+  padding: 0 6px !important;
+}
+.tried {
+  opacity: 0.75;
+  white-space: normal;
+}
+</style>
diff --git a/photon-client/src/components/fieldcal/FieldCal3D.vue b/photon-client/src/components/fieldcal/FieldCal3D.vue
new file mode 100644
index 00000000..6d31f124
--- /dev/null
+++ b/photon-client/src/components/fieldcal/FieldCal3D.vue
@@ -0,0 +1,353 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-30): the field in 3D for the field-calibration page, with simplified
+// field elements placed by their tags (lib/FieldElements.ts). Tags are coloured like the 2D map;
+// live cameras, captured spots and (on results) each tag's solved offset, drawn 10x.
+// @ts-expect-error Intellisense says these conflict with the dynamic imports below
+import type { Group, Object3D, PerspectiveCamera, Scene, WebGLRenderer } from "three";
+import { onBeforeUnmount, onMounted, ref, watch } from "vue";
+import { useTheme } from "vuetify";
+import type { AprilTagFieldLayout } from "@/types/PhotonTrackingTypes";
+import type { MapCamera, MapOffset, MapPoint } from "@/types/FieldCalTypes";
+import { buildField, detectGame, FIELD_GAMES, fieldModelUrl } from "@/lib/FieldElements";
+import { anchorFieldModel, loadFieldModel } from "@/lib/FieldModel";
+
+const T = await import("three");
+const { OrbitControls } = await import("three/examples/jsm/controls/OrbitControls");
+
+const props = defineProps<{
+  layout: AprilTagFieldLayout;
+  tagSpots?: Record<string, number>;
+  inView?: number[];
+  cameras?: MapCamera[];
+  spots?: MapPoint[];
+  offsets?: Record<string, MapOffset>;
+}>();
+
+const theme = useTheme();
+const container = ref<HTMLDivElement | null>(null);
+const game = ref(detectGame(props.layout));
+let scene: Scene | undefined;
+let camera: PerspectiveCamera | undefined;
+let renderer: WebGLRenderer | undefined;
+let controls: InstanceType<typeof OrbitControls> | undefined;
+let fieldGroup: Group | undefined;
+let modelGroup: Group | undefined; // shares the cached model's geometry: removed, never disposed
+const modelNote = ref("");
+let tagGroup: Group | undefined;
+let liveGroup: Group | undefined;
+let frame = 0;
+let resize: ResizeObserver | undefined;
+
+const TAG = 0.1651;
+const tagTexture = new Map<number, InstanceType<typeof T.CanvasTexture>>();
+const textureFor = (id: number) => {
+  let t = tagTexture.get(id);
+  if (t) return t;
+  const c = document.createElement("canvas");
+  c.width = c.height = 128;
+  const x = c.getContext("2d")!;
+  x.fillStyle = "#fff";
+  x.fillRect(0, 0, 128, 128);
+  x.fillStyle = "#000";
+  x.fillRect(10, 10, 108, 108);
+  x.fillStyle = "#fff";
+  x.fillRect(26, 26, 76, 76);
+  x.fillStyle = "#000";
+  x.font = "bold 56px sans-serif";
+  x.textAlign = "center";
+  x.textBaseline = "middle";
+  x.fillText(String(id), 64, 68);
+  t = new T.CanvasTexture(c);
+  tagTexture.set(id, t);
+  return t;
+};
+
+const statusColor = (id: number): number => {
+  if (props.offsets) {
+    const o = props.offsets[String(id)];
+    return o ? (o.moved ? 0xe53935 : 0x43a047) : 0x9e9e9e;
+  }
+  const n = props.tagSpots?.[String(id)] ?? 0;
+  if (n >= 2) return 0x43a047;
+  if (n === 1) return 0xfb8c00;
+  return props.inView?.includes(id) ? 0x1e88e5 : 0x9e9e9e;
+};
+
+// A plane faces +Z with +X right and +Y up; a tag faces its +x, with +y to the viewer's right and +z up.
+const TAG_BASIS = new T.Quaternion().setFromRotationMatrix(
+  new T.Matrix4().makeBasis(new T.Vector3(0, 1, 0), new T.Vector3(0, 0, 1), new T.Vector3(1, 0, 0))
+);
+
+const disposeGroup = (g: Object3D | undefined) => {
+  if (!g || !scene) return;
+  scene.remove(g);
+  g.traverse((o: any) => {
+    o.geometry?.dispose?.();
+    o.material?.dispose?.(); // tag textures are shared and kept (disposed on unmount)
+  });
+};
+
+let fieldToken = 0;
+const drawField = async () => {
+  if (!scene) return;
+  const token = ++fieldToken;
+  disposeGroup(fieldGroup);
+  if (modelGroup) scene.remove(modelGroup);
+  modelGroup = undefined;
+  const url = fieldModelUrl(game.value);
+  // The walls and carpet at once; the CAD model replaces them when it has loaded.
+  fieldGroup = buildField(T, props.layout, url ? "none" : game.value);
+  scene.add(fieldGroup);
+  modelNote.value = "";
+  if (!url) return;
+  modelNote.value = "Loading FIRST's field CAD…";
+  const model = await loadFieldModel(T, url);
+  if (token !== fieldToken || !scene) return; // redrawn meanwhile
+  if (!model) {
+    modelNote.value = "The field CAD didn't load: showing simple shapes.";
+    disposeGroup(fieldGroup);
+    fieldGroup = buildField(T, props.layout, "2026");
+    scene.add(fieldGroup);
+  } else {
+    anchorFieldModel(T, model, props.layout);
+    disposeGroup(fieldGroup);
+    fieldGroup = undefined;
+    modelGroup = model;
+    scene.add(model);
+    modelNote.value = "";
+  }
+  renderNow();
+};
+
+const drawTags = () => {
+  if (!scene) return;
+  disposeGroup(tagGroup);
+  tagGroup = new T.Group();
+  for (const t of props.layout.tags) {
+    const q = t.pose.rotation.quaternion;
+    const quat = new T.Quaternion(q.X, q.Y, q.Z, q.W).multiply(TAG_BASIS);
+    const pos = new T.Vector3(t.pose.translation.x, t.pose.translation.y, t.pose.translation.z);
+    const normal = new T.Vector3(1, 0, 0).applyQuaternion(new T.Quaternion(q.X, q.Y, q.Z, q.W));
+    // coloured frame behind, the tag in front (both just off the element's face)
+    const frameMesh = new T.Mesh(
+      new T.PlaneGeometry(TAG * 1.7, TAG * 1.7),
+      new T.MeshBasicMaterial({ color: statusColor(t.ID), side: T.DoubleSide })
+    );
+    frameMesh.quaternion.copy(quat);
+    frameMesh.position.copy(pos).addScaledVector(normal, 0.01);
+    const face = new T.Mesh(
+      new T.PlaneGeometry(TAG * 1.25, TAG * 1.25),
+      new T.MeshBasicMaterial({ map: textureFor(t.ID) })
+    );
+    face.quaternion.copy(quat);
+    face.position.copy(pos).addScaledVector(normal, 0.015);
+    tagGroup.add(frameMesh, face);
+    const o = props.offsets?.[String(t.ID)];
+    if (o) {
+      const d = new T.Vector3(o.dxCm / 10, o.dyCm / 10, 0); // cm drawn 10x: /100 * 10
+      if (d.length() > 0.01) {
+        tagGroup.add(
+          new T.ArrowHelper(d.clone().normalize(), pos, d.length(), o.moved ? 0xe53935 : 0x43a047, 0.12, 0.08)
+        );
+      }
+    }
+  }
+  scene.add(tagGroup);
+};
+
+const drawLive = () => {
+  if (!scene) return;
+  disposeGroup(liveGroup);
+  liveGroup = new T.Group();
+  for (const s of props.spots ?? []) {
+    const disc = new T.Mesh(
+      new T.CircleGeometry(0.18, 24),
+      new T.MeshBasicMaterial({ color: 0x1e88e5, transparent: true, opacity: 0.6 })
+    );
+    disc.position.set(s.x, s.y, 0.01);
+    liveGroup.add(disc);
+  }
+  for (const c of props.cameras ?? []) {
+    if (!c.pose) continue;
+    const cone = new T.Mesh(new T.ConeGeometry(0.1, 0.25, 16), new T.MeshLambertMaterial({ color: 0x00acc1 }));
+    // cone points along +y; turn it to the camera's heading
+    cone.rotation.z = c.pose[2] - Math.PI / 2;
+    cone.position.set(c.pose[0], c.pose[1], 0.45);
+    liveGroup.add(cone);
+    const ray = new T.ArrowHelper(
+      new T.Vector3(Math.cos(c.pose[2]), Math.sin(c.pose[2]), 0),
+      new T.Vector3(c.pose[0], c.pose[1], 0.45),
+      1.2,
+      0x00acc1,
+      0.15,
+      0.08
+    );
+    liveGroup.add(ray);
+  }
+  scene.add(liveGroup);
+};
+
+// Draw now, not just on the next animation frame (which a hidden tab never gets).
+const renderNow = () => {
+  if (renderer && scene && camera) renderer.render(scene, camera);
+};
+
+const setBackground = () => {
+  if (scene) scene.background = new T.Color(theme.global.current.value.dark ? 0x101418 : 0xd9dde1);
+};
+
+const view = (which: "blue" | "red" | "top") => {
+  if (!camera || !controls) return;
+  const L = props.layout.field.length,
+    W = props.layout.field.width;
+  if (which === "top") {
+    // High enough that the whole field fits the canvas, whichever way it's shaped.
+    const t = Math.tan((camera.fov * Math.PI) / 360);
+    const h = 1.1 * Math.max(L / 2 / (t * camera.aspect), W / 2 / t);
+    camera.position.set(L / 2, W / 2 - 0.01, h);
+    controls.target.set(L / 2, W / 2, 0);
+  } else if (which === "blue") {
+    camera.position.set(-4, W / 2, 5.5);
+    controls.target.set(L * 0.3, W / 2, 0);
+  } else {
+    camera.position.set(L + 4, W / 2, 5.5);
+    controls.target.set(L * 0.7, W / 2, 0);
+  }
+  controls.update();
+  renderNow();
+};
+
+onMounted(() => {
+  const el = container.value;
+  if (!el) return;
+  scene = new T.Scene();
+  setBackground();
+  camera = new T.PerspectiveCamera(50, el.clientWidth / Math.max(1, el.clientHeight), 0.05, 200);
+  camera.up.set(0, 0, 1);
+  renderer = new T.WebGLRenderer({ antialias: true });
+  renderer.setPixelRatio(window.devicePixelRatio);
+  renderer.setSize(el.clientWidth, el.clientHeight);
+  el.appendChild(renderer.domElement);
+  controls = new OrbitControls(camera, renderer.domElement);
+  controls.enableDamping = true;
+  // Onshape's default mouse: right-drag turns, middle-drag (or Ctrl + right-drag) moves, the wheel
+  // zooms toward the cursor. Left-drag also turns (there's nothing to select), for trackpads.
+  controls.mouseButtons = { LEFT: T.MOUSE.ROTATE, MIDDLE: T.MOUSE.PAN, RIGHT: T.MOUSE.ROTATE };
+  controls.zoomToCursor = true;
+  controls.screenSpacePanning = true;
+  controls.maxPolarAngle = Math.PI / 2 - 0.03; // stay above the carpet
+  scene.add(new T.HemisphereLight(0xffffff, 0x444444, 1.2));
+  scene.add(new T.AmbientLight(0xffffff, 0.8));
+  const sun = new T.DirectionalLight(0xffffff, 1.4);
+  sun.position.set(5, -3, 10);
+  scene.add(sun);
+  drawField();
+  drawTags();
+  drawLive();
+  view(
+    props.layout.tags.some(
+      (t) => (props.tagSpots?.[String(t.ID)] ?? 0) > 0 && t.pose.translation.x > props.layout.field.length / 2
+    )
+      ? "red"
+      : "blue"
+  );
+  resize = new ResizeObserver(() => {
+    if (!renderer || !camera || !el) return;
+    renderer.setSize(el.clientWidth, el.clientHeight);
+    camera.aspect = el.clientWidth / Math.max(1, el.clientHeight);
+    camera.updateProjectionMatrix();
+  });
+  resize.observe(el);
+  const loop = () => {
+    frame = requestAnimationFrame(loop);
+    controls?.update();
+    if (renderer && scene && camera) renderer.render(scene, camera);
+  };
+  loop();
+});
+
+onBeforeUnmount(() => {
+  cancelAnimationFrame(frame);
+  resize?.disconnect();
+  disposeGroup(fieldGroup);
+  if (modelGroup) scene?.remove(modelGroup);
+  disposeGroup(tagGroup);
+  disposeGroup(liveGroup);
+  tagTexture.forEach((t) => t.dispose());
+  controls?.dispose();
+  renderer?.dispose();
+  renderer?.domElement.remove();
+});
+
+watch(
+  () => [props.layout, game.value],
+  () => {
+    drawField();
+    renderNow();
+  }
+);
+watch(
+  () => [props.layout, props.tagSpots, props.inView, props.offsets],
+  () => {
+    drawTags();
+    renderNow();
+  },
+  { deep: true }
+);
+watch(
+  () => [props.cameras, props.spots],
+  () => {
+    drawLive();
+    renderNow();
+  },
+  { deep: true }
+);
+watch(
+  () => theme.global.current.value.dark,
+  () => {
+    setBackground();
+    renderNow();
+  }
+);
+</script>
+
+<template>
+  <div>
+    <div class="d-flex align-center flex-wrap mb-1" style="gap: 6px">
+      <v-btn size="x-small" variant="tonal" @click="view('blue')">Blue wall</v-btn>
+      <v-btn size="x-small" variant="tonal" @click="view('red')">Red wall</v-btn>
+      <v-btn size="x-small" variant="tonal" @click="view('top')">Top</v-btn>
+      <v-select
+        v-model="game"
+        :items="FIELD_GAMES"
+        item-title="name"
+        item-value="id"
+        density="compact"
+        hide-details
+        variant="outlined"
+        style="max-width: 220px"
+        class="ml-2"
+      />
+    </div>
+    <div ref="container" class="fieldcal-3d" />
+    <div class="text-caption">
+      Like Onshape: right-drag to turn, middle-drag or Ctrl + right-drag to move, scroll to zoom.
+      {{
+        modelNote ||
+        (game === "2026cad"
+          ? "The field is FIRST's official CAD, each element placed by its tags."
+          : "Field elements are simplified.")
+      }}
+    </div>
+  </div>
+</template>
+
+<style scoped>
+.fieldcal-3d {
+  width: 100%;
+  height: 55vh;
+  min-height: 320px;
+  border-radius: 8px;
+  overflow: hidden;
+}
+</style>
diff --git a/photon-client/src/components/fieldcal/FieldCalMap.vue b/photon-client/src/components/fieldcal/FieldCalMap.vue
new file mode 100644
index 00000000..b70eea25
--- /dev/null
+++ b/photon-client/src/components/fieldcal/FieldCalMap.vue
@@ -0,0 +1,211 @@
+<script setup lang="ts">
+// SpectrumJetson (photonvision-30): the field from above for the field-calibration page. Tags are
+// coloured by how many still spots have seen them; live cameras, captured spots, the suggested
+// next spot, and (on results) each tag's solved offset, exaggerated so centimetres show.
+import { computed } from "vue";
+import type { AprilTagFieldLayout } from "@/types/PhotonTrackingTypes";
+import type { MapCamera, MapOffset, MapPoint, MapSuggestion } from "@/types/FieldCalTypes";
+
+const props = defineProps<{
+  layout: AprilTagFieldLayout;
+  tagSpots?: Record<string, number>;
+  inView?: number[];
+  cameras?: MapCamera[];
+  spots?: MapPoint[];
+  suggestion?: MapSuggestion | null;
+  offsets?: Record<string, MapOffset>;
+  focusSeen?: boolean;
+}>();
+
+const OFFSET_SCALE = 10; // 1 cm drawn as 10 cm
+
+const yawOf = (q: { W: number; X: number; Y: number; Z: number }) =>
+  Math.atan2(2 * (q.W * q.Z + q.X * q.Y), 1 - 2 * (q.Y * q.Y + q.Z * q.Z));
+
+const W = computed(() => props.layout.field.width);
+const L = computed(() => props.layout.field.length);
+
+const tags = computed(() =>
+  props.layout.tags.map((t) => ({
+    id: t.ID,
+    x: t.pose.translation.x,
+    y: t.pose.translation.y,
+    yaw: yawOf(t.pose.rotation.quaternion),
+    spots: props.tagSpots?.[String(t.ID)] ?? 0
+  }))
+);
+
+// With focusSeen, zoom to the tags seen so far (the part of the field in use), plus a margin.
+const view = computed(() => {
+  let x0 = 0,
+    y0 = 0,
+    x1 = L.value,
+    y1 = W.value;
+  const seen = tags.value.filter((t) => t.spots > 0 || props.inView?.includes(t.id) || props.offsets?.[String(t.id)]);
+  if (props.focusSeen && seen.length >= 2) {
+    x0 = Math.max(0, Math.min(...seen.map((t) => t.x)) - 2);
+    x1 = Math.min(L.value, Math.max(...seen.map((t) => t.x)) + 2);
+    y0 = Math.max(0, Math.min(...seen.map((t) => t.y)) - 2);
+    y1 = Math.min(W.value, Math.max(...seen.map((t) => t.y)) + 2);
+  }
+  return { x0, y0, x1, y1 };
+});
+const viewBox = computed(() => {
+  const v = view.value;
+  // SVG y points down: field y = W at the top.
+  return `${v.x0 - 0.4} ${W.value - v.y1 - 0.4} ${v.x1 - v.x0 + 0.8} ${v.y1 - v.y0 + 0.8}`;
+});
+const sy = (y: number) => W.value - y;
+
+const tagColor = (t: { id: number; spots: number }) => {
+  if (props.offsets) {
+    const o = props.offsets[String(t.id)];
+    return o ? (o.moved ? "#e53935" : "#43a047") : "#9e9e9e";
+  }
+  if (t.spots >= 2) return "#43a047";
+  if (t.spots === 1) return "#fb8c00";
+  return props.inView?.includes(t.id) ? "#1e88e5" : "#9e9e9e";
+};
+</script>
+
+<template>
+  <svg :viewBox="viewBox" class="fieldcal-map" preserveAspectRatio="xMidYMid meet">
+    <rect :x="0" :y="0" :width="L" :height="W" class="field" />
+    <line :x1="L / 2" :y1="0" :x2="L / 2" :y2="W" class="midline" />
+
+    <!-- captured spots -->
+    <g v-for="(s, i) in spots ?? []" :key="'s' + i">
+      <circle :cx="s.x" :cy="sy(s.y)" r="0.16" class="spot" />
+      <text :x="s.x" :y="sy(s.y) + 0.09" class="spot-label">{{ s.label ?? i + 1 }}</text>
+    </g>
+
+    <!-- tags: the face, and a tick pointing the way it faces -->
+    <g v-for="t in tags" :key="t.id">
+      <line
+        :x1="t.x + 0.22 * Math.sin(t.yaw)"
+        :y1="sy(t.y - 0.22 * Math.cos(t.yaw))"
+        :x2="t.x - 0.22 * Math.sin(t.yaw)"
+        :y2="sy(t.y + 0.22 * Math.cos(t.yaw))"
+        :stroke="tagColor(t)"
+        stroke-width="0.12"
+        stroke-linecap="round"
+      />
+      <line
+        :x1="t.x"
+        :y1="sy(t.y)"
+        :x2="t.x + 0.3 * Math.cos(t.yaw)"
+        :y2="sy(t.y + 0.3 * Math.sin(t.yaw))"
+        :stroke="tagColor(t)"
+        stroke-width="0.05"
+      />
+      <circle v-if="inView?.includes(t.id)" :cx="t.x" :cy="sy(t.y)" r="0.35" class="in-view" />
+      <text :x="t.x + 0.6 * Math.cos(t.yaw)" :y="sy(t.y + 0.6 * Math.sin(t.yaw)) + 0.1" class="tag-label">
+        {{ t.id }}
+      </text>
+      <!-- solved offset (results) -->
+      <line
+        v-if="offsets?.[String(t.id)]"
+        :x1="t.x"
+        :y1="sy(t.y)"
+        :x2="t.x + (offsets[String(t.id)].dxCm / 100) * OFFSET_SCALE"
+        :y2="sy(t.y + (offsets[String(t.id)].dyCm / 100) * OFFSET_SCALE)"
+        :stroke="offsets[String(t.id)].moved ? '#e53935' : '#43a047'"
+        stroke-width="0.06"
+        marker-end="url(#fc-arrow)"
+      />
+    </g>
+
+    <!-- the suggested next spot -->
+    <g v-if="suggestion" class="suggestion">
+      <line
+        :x1="suggestion.x"
+        :y1="sy(suggestion.y)"
+        :x2="suggestion.faceX"
+        :y2="sy(suggestion.faceY)"
+        stroke="#8e24aa"
+        stroke-width="0.05"
+        stroke-dasharray="0.15 0.1"
+      />
+      <circle :cx="suggestion.x" :cy="sy(suggestion.y)" r="0.45" class="suggest-ring" />
+      <text :x="suggestion.x" :y="sy(suggestion.y) + 0.12" class="suggest-label">next</text>
+    </g>
+
+    <!-- live cameras: where each is and which way it looks -->
+    <g v-for="c in (cameras ?? []).filter((c) => c.pose)" :key="c.name">
+      <line
+        :x1="c.pose![0]"
+        :y1="sy(c.pose![1])"
+        :x2="c.pose![0] + 0.7 * Math.cos(c.pose![2])"
+        :y2="sy(c.pose![1] + 0.7 * Math.sin(c.pose![2]))"
+        stroke="#00acc1"
+        stroke-width="0.07"
+        marker-end="url(#fc-arrow-cam)"
+      />
+      <circle :cx="c.pose![0]" :cy="sy(c.pose![1])" r="0.12" fill="#00acc1" />
+    </g>
+
+    <defs>
+      <marker id="fc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
+        <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
+      </marker>
+      <marker id="fc-arrow-cam" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto">
+        <path d="M0,0 L10,5 L0,10 z" fill="#00acc1" />
+      </marker>
+    </defs>
+  </svg>
+</template>
+
+<style scoped>
+.fieldcal-map {
+  width: 100%;
+  max-height: 60vh;
+  background: rgba(127, 127, 127, 0.06);
+  border-radius: 8px;
+}
+.field {
+  fill: rgba(76, 175, 80, 0.07);
+  stroke: rgba(127, 127, 127, 0.8);
+  stroke-width: 0.04;
+}
+.midline {
+  stroke: rgba(127, 127, 127, 0.4);
+  stroke-width: 0.03;
+  stroke-dasharray: 0.2 0.15;
+}
+.tag-label {
+  font-size: 0.3px;
+  text-anchor: middle;
+  fill: currentColor;
+}
+.in-view {
+  fill: none;
+  stroke: #1e88e5;
+  stroke-width: 0.04;
+}
+.spot {
+  fill: rgba(33, 150, 243, 0.25);
+  stroke: #1e88e5;
+  stroke-width: 0.03;
+}
+.spot-label {
+  font-size: 0.2px;
+  text-anchor: middle;
+  fill: currentColor;
+}
+.suggest-ring {
+  fill: rgba(142, 36, 170, 0.15);
+  stroke: #8e24aa;
+  stroke-width: 0.05;
+  animation: pulse 1.2s ease-in-out infinite;
+}
+.suggest-label {
+  font-size: 0.28px;
+  text-anchor: middle;
+  fill: #8e24aa;
+}
+@keyframes pulse {
+  50% {
+    opacity: 0.4;
+  }
+}
+</style>
diff --git a/photon-client/src/lib/FieldElements.ts b/photon-client/src/lib/FieldElements.ts
new file mode 100644
index 00000000..733d924d
--- /dev/null
+++ b/photon-client/src/lib/FieldElements.ts
@@ -0,0 +1,223 @@
+// SpectrumJetson (photonvision-30): simplified 3D field elements, like Limelight's field view.
+// Each element is placed by the tags mounted on it, not by fixed coordinates: the same code draws
+// the AndyMark and welded fields, and after a field calibration the elements sit where their tags
+// really are (a misplaced hub shows up misplaced). Dimensions: the 2026 game manual (arena section).
+import type * as ThreeNS from "three";
+import type { AprilTagFieldLayout } from "@/types/PhotonTrackingTypes";
+
+type Three = typeof ThreeNS;
+type TagPose = { x: number; y: number; z: number; yaw: number };
+
+export type FieldGame = { id: string; name: string };
+export const FIELD_GAMES: FieldGame[] = [
+  { id: "2026cad", name: "2026 REBUILT: FIRST's field CAD" },
+  { id: "2026", name: "2026 REBUILT: simple shapes" },
+  { id: "none", name: "Tags and walls only" }
+];
+
+/** Which game a layout is for, from its size and tags. */
+export const detectGame = (layout: AprilTagFieldLayout): string =>
+  layout.tags.length === 32 && Math.abs(layout.field.length - 16.54) < 0.1 && Math.abs(layout.field.width - 8.05) < 0.1
+    ? "2026cad"
+    : "none";
+
+/** The CAD model for a game, if there is one (served from PhotonVision's web root). */
+export const fieldModelUrl = (game: string): string | null =>
+  game === "2026cad" ? "fieldmodels/2026-rebuilt.glb" : null;
+
+const IN = 0.0254;
+const BLUE = 0x1e63d6;
+const RED = 0xd63a2f;
+const GREY = 0x9aa0a6;
+
+// 2026 REBUILT: which tags sit on which element (blue, red).
+const REBUILT = {
+  hubs: [
+    [18, 19, 20, 21, 24, 25, 26, 27],
+    [2, 3, 4, 5, 8, 9, 10, 11]
+  ],
+  trenches: [
+    [17, 28],
+    [22, 23],
+    [1, 12],
+    [6, 7]
+  ],
+  outposts: [
+    [29, 30],
+    [13, 14]
+  ],
+  towers: [
+    [31, 32],
+    [15, 16]
+  ]
+};
+const HUB = { size: 47 * IN, height: 72 * IN };
+const TRENCH = {
+  width: 65.65 * IN,
+  depth: 47.0 * IN,
+  height: 40.25 * IN,
+  openWidth: 50.34 * IN,
+  openHeight: 22.25 * IN
+};
+const BUMP = { depth: 44.4 * IN, height: 6.513 * IN };
+const TOWER = { width: 49.25 * IN, depth: 45.0 * IN, height: 78.25 * IN, upright: 72.1 * IN, spacing: 32.25 * IN };
+const RUNGS = [27.0 * IN, 45.0 * IN, 63.0 * IN];
+const GUARDRAIL = 20.0 * IN;
+const WALL = 78 * IN; // driver station wall with its transparent panel
+
+export const yawOf = (q: { W: number; X: number; Y: number; Z: number }) =>
+  Math.atan2(2 * (q.W * q.Z + q.X * q.Y), 1 - 2 * (q.Y * q.Y + q.Z * q.Z));
+
+/** The field, walls and elements for a layout; tags are drawn by the caller. */
+export function buildField(T: Three, layout: AprilTagFieldLayout, game: string): ThreeNS.Group {
+  const g = new T.Group();
+  const L = layout.field.length,
+    W = layout.field.width;
+  const mat = (color: number, opacity = 1) =>
+    new T.MeshLambertMaterial({ color, transparent: opacity < 1, opacity, side: T.DoubleSide });
+  const box = (
+    sx: number,
+    sy: number,
+    sz: number,
+    x: number,
+    y: number,
+    z: number,
+    yaw: number,
+    m: ThreeNS.Material
+  ) => {
+    const b = new T.Mesh(new T.BoxGeometry(sx, sy, sz), m);
+    b.position.set(x, y, z);
+    b.rotation.z = yaw;
+    g.add(b);
+    return b;
+  };
+
+  // Carpet, alliance zones and centre line.
+  const carpet = new T.Mesh(new T.PlaneGeometry(L, W), mat(0x5a5f63));
+  carpet.position.set(L / 2, W / 2, 0);
+  g.add(carpet);
+  const line = (x: number, color: number) => {
+    const l = new T.Mesh(new T.PlaneGeometry(0.05, W), mat(color));
+    l.position.set(x, W / 2, 0.002);
+    g.add(l);
+  };
+  line(L / 2, 0xffffff);
+  // Guardrails and alliance walls (translucent so the field stays visible).
+  box(L, 0.05, GUARDRAIL, L / 2, -0.025, GUARDRAIL / 2, 0, mat(GREY, 0.35));
+  box(L, 0.05, GUARDRAIL, L / 2, W + 0.025, GUARDRAIL / 2, 0, mat(GREY, 0.35));
+  // Alliance walls: faint, with their edges drawn, so the view through them stays clear.
+  for (const [x, c] of [
+    [-0.025, BLUE],
+    [L + 0.025, RED]
+  ]) {
+    const w = box(0.05, W, WALL, x, W / 2, WALL / 2, 0, mat(c, 0.08));
+    w.add(new T.LineSegments(new T.EdgesGeometry(w.geometry), new T.LineBasicMaterial({ color: c })));
+  }
+
+  if (game !== "2026") return g;
+
+  const tags = new Map<number, TagPose>();
+  for (const t of layout.tags) {
+    tags.set(t.ID, {
+      x: t.pose.translation.x,
+      y: t.pose.translation.y,
+      z: t.pose.translation.z,
+      yaw: yawOf(t.pose.rotation.quaternion)
+    });
+  }
+  const group = (ids: number[]) => ids.map((i) => tags.get(i)).filter((t): t is TagPose => !!t);
+  const mean = (ts: TagPose[]) => ({
+    x: ts.reduce((a, t) => a + t.x, 0) / ts.length,
+    y: ts.reduce((a, t) => a + t.y, 0) / ts.length
+  });
+  const colour = (x: number) => (x < L / 2 ? BLUE : RED);
+
+  // HUBs: a 47 in square, 72 in tall, centred on its tags, square to them.
+  const hubs: { x: number; y: number }[] = [];
+  for (const ids of REBUILT.hubs) {
+    const ts = group(ids);
+    if (ts.length < 3) continue;
+    const c = mean(ts);
+    hubs.push(c);
+    box(HUB.size, HUB.size, HUB.height, c.x, c.y, HUB.height / 2, ts[0].yaw, mat(colour(c.x), 0.55));
+    // the hexagonal opening at the top, as a dark ring
+    const ring = new T.Mesh(new T.CylinderGeometry(0.53, 0.53, 0.04, 6, 1, true), mat(0x222222));
+    ring.rotation.x = Math.PI / 2;
+    ring.position.set(c.x, c.y, HUB.height);
+    g.add(ring);
+  }
+
+  // TRENCHes: against the guardrail, a slab on two legs over a 22.25 in tall tunnel.
+  for (const ids of REBUILT.trenches) {
+    const ts = group(ids);
+    if (!ts.length) continue;
+    const c = mean(ts);
+    const nearZero = c.y < W / 2;
+    const y0 = nearZero ? 0 : W - TRENCH.width;
+    const yc = y0 + TRENCH.width / 2;
+    const m = mat(colour(c.x), 0.6);
+    const slab = TRENCH.height - TRENCH.openHeight;
+    box(TRENCH.depth, TRENCH.width, slab, c.x, yc, TRENCH.openHeight + slab / 2, 0, m);
+    const leg = (TRENCH.width - TRENCH.openWidth) / 2;
+    box(TRENCH.depth, leg, TRENCH.openHeight, c.x, y0 + leg / 2, TRENCH.openHeight / 2, 0, m);
+    box(TRENCH.depth, leg, TRENCH.openHeight, c.x, y0 + TRENCH.width - leg / 2, TRENCH.openHeight / 2, 0, m);
+  }
+
+  // BUMPs: 15-degree ramps either side of each hub, out to the trenches.
+  for (const h of hubs) {
+    for (const [a, b] of [
+      [TRENCH.width, h.y - HUB.size / 2],
+      [h.y + HUB.size / 2, W - TRENCH.width]
+    ]) {
+      if (b - a < 0.2) continue;
+      const shape = new T.Shape();
+      shape.moveTo(-BUMP.depth / 2, 0);
+      shape.lineTo(0, BUMP.height);
+      shape.lineTo(BUMP.depth / 2, 0);
+      shape.lineTo(-BUMP.depth / 2, 0);
+      const geo = new T.ExtrudeGeometry(shape, { depth: b - a, bevelEnabled: false });
+      const bump = new T.Mesh(geo, mat(colour(h.x), 0.8));
+      // shape x -> field x, shape y -> up, extrusion -> field y
+      bump.rotation.x = Math.PI / 2;
+      bump.position.set(h.x, b, 0);
+      g.add(bump);
+    }
+  }
+
+  // TOWERs: on the alliance wall at its tags, a base, two uprights and three rungs.
+  for (const ids of REBUILT.towers) {
+    const ts = group(ids);
+    if (!ts.length) continue;
+    const c = mean(ts);
+    const dir = Math.cos(ts[0].yaw) >= 0 ? 1 : -1; // into the field
+    const m = mat(colour(c.x), 0.85);
+    const xMid = c.x + (dir * TOWER.depth) / 2;
+    box(TOWER.depth, TOWER.width, 0.04, xMid, c.y, 0.02, 0, m);
+    box(0.05, TOWER.width, TOWER.height, c.x + dir * 0.03, c.y, TOWER.height / 2, 0, mat(colour(c.x), 0.3));
+    for (const s of [-1, 1])
+      box(0.06, 0.06, TOWER.upright, xMid, c.y + (s * TOWER.spacing) / 2, TOWER.upright / 2, 0, m);
+    for (const z of RUNGS) {
+      const rung = new T.Mesh(new T.CylinderGeometry(0.03, 0.03, TOWER.spacing, 12), mat(0xdddddd));
+      rung.position.set(xMid, c.y, z);
+      g.add(rung);
+    }
+  }
+
+  // OUTPOSTs: a panel in the alliance wall at its tags, with the low corral in front.
+  for (const ids of REBUILT.outposts) {
+    const ts = group(ids);
+    if (!ts.length) continue;
+    const c = mean(ts);
+    const dir = Math.cos(ts[0].yaw) >= 0 ? 1 : -1;
+    box(0.12, 1.1, 1.2, c.x + dir * 0.06, c.y, 0.6, 0, mat(colour(c.x), 0.5));
+    const cw = 35.8 * IN,
+      cd = 37.6 * IN,
+      ch = 8.13 * IN;
+    const m = mat(colour(c.x), 0.7);
+    const x0 = c.x + dir * 0.12;
+    box(cd, 0.03, ch, x0 + (dir * cd) / 2, c.y - cw / 2, ch / 2, 0, m);
+    box(cd, 0.03, ch, x0 + (dir * cd) / 2, c.y + cw / 2, ch / 2, 0, m);
+    box(0.03, cw, ch, x0 + dir * cd, c.y, ch / 2, 0, m);
+  }
+  return g;
+}
diff --git a/photon-client/src/lib/FieldModel.ts b/photon-client/src/lib/FieldModel.ts
