+// SpectrumJetson (photonvision-30): shapes the field-calibration map draws.
+export type MapCamera = { name: string; pose: number[] | null };
+export type MapPoint = { x: number; y: number; label?: string };
+export type MapSuggestion = { x: number; y: number; tag: number; faceX: number; faceY: number };
+export type MapOffset = { dxCm: number; dyCm: number; moved: boolean };
+
+// The settings step (CameraTuneCard).
+export type Control = { min: number; max: number; default: number; value: number };
+export type TuneStep = {
+  control: string;
+  value: number;
+  frames: number;
+  found: number;
+  margin: number;
+  jitterPx: number;
+  brightness: number;
+};
+export type TuneCamera = {
+  problem: string;
+  outcome: string;
+  tuning: boolean;
+  locked: string[];
+  baselineTags: number[];
+  baseline: TuneStep | null;
+  startValues: Record<string, number>;
+  recommended: Record<string, number>;
+  notes: Record<string, string>;
+  results: TuneStep[];
+  pipelineIndex: number;
+};
diff --git a/photon-client/src/views/FieldCalibrationView.vue b/photon-client/src/views/FieldCalibrationView.vue
