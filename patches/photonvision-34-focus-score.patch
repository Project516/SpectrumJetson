+    private static org.photonvision.vision.processes.VisionModule moduleByUniqueName(String name) {
+        for (var m : VisionSourceManager.getInstance().vmm.getModules()) {
+            if (m.uniqueName().equals(name)) return m;
+        }
+        return null;
+    }
+
+    /**
