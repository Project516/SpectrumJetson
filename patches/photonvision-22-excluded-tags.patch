@@ -464,6 +464,44 @@ public class RequestHandler {
 
     // SpectrumJetson Rewind. POST body, all optional:
     // {"manual": true|false, "fps": 30, "quotaGB": 100, "minFreeGB": 15, "delete": "<session>"}
+    // SpectrumJetson (photonvision-22): tags left out of multi-tag on every camera.
+    private record ExcludedTagsRequest(java.util.List<Integer> saved) {}
+
+    private static java.util.Map<String, Object> excludedTagsStatus() {
+        var et = org.photonvision.vision.target.ExcludedTags.getInstance();
+        return java.util.Map.of(
+                "saved", new java.util.TreeSet<>(et.saved()),
+                "robot", new java.util.TreeSet<>(et.robot()),
+                "active", new java.util.TreeSet<>(et.active()));
+    }
+
+    /** GET /api/excludedTags: {saved, robot, active}. */
+    public static void onExcludedTagsRequest(Context ctx) {
+        try {
+            ctx.status(200);
+            ctx.result(kObjectMapper.writeValueAsString(excludedTagsStatus()));
+            ctx.contentType("application/json");
+        } catch (JsonProcessingException e) {
+            ctx.status(500);
+            ctx.result("Could not read the excluded tags");
+        }
+    }
+
+    /** POST /api/excludedTags {"saved": [7, 12]}: replaces the list saved on the Jetson. */
+    public static void onExcludedTagsSetRequest(Context ctx) {
+        try {
+            var req = kObjectMapper.readValue(ctx.body(), ExcludedTagsRequest.class);
+            org.photonvision.vision.target.ExcludedTags.getInstance()
+                    .setSaved(req.saved() == null ? java.util.List.of() : req.saved());
+            ctx.status(200);
+            ctx.result(kObjectMapper.writeValueAsString(excludedTagsStatus()));
+            ctx.contentType("application/json");
+        } catch (IOException e) {
+            ctx.status(400);
+            ctx.result("Expected {\"saved\": [tag IDs]}");
+        }
+    }
+
     private record RewindRequest(
             Boolean manual, Double fps, Double quotaGB, Double minFreeGB, String delete) {}
 
