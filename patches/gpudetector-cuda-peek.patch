+// SpectrumJetson: report (once per stage) and clear any pending CUDA error, so a
+// stale error from an unchecked call can't make later CUB calls bail out via
+// cudaPeekAtLastError.
+#define SPECTRUM_CUDA_PEEK(stage)                                              \
+  do {                                                                         \
+    cudaError_t spectrum_e_ = cudaGetLastError();                              \
+    static bool spectrum_logged_ = false;                                      \
+    if (spectrum_e_ != cudaSuccess && !spectrum_logged_) {                     \
+      spectrum_logged_ = true;                                                 \
+      std::cerr << "CUDA_PEEK after " stage ": "                               \
+                << cudaGetErrorString(spectrum_e_) << std::endl;               \
+    }                                                                          \
+  } while (0)
+
