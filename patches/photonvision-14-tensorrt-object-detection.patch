+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+package org.photonvision.jni;
+
+import java.io.File;
+
+/**
+ * SpectrumJetson: TensorRT YOLO object detection on the Jetson (libspectrumtrt.so, built from
+ * SpectrumJetson's detector/TensorRtYoloJNI.cu and installed to /usr/lib).
+ *
+ * <p>Loaded lazily, the first time a TensorRT model is used: TensorRT is a very large library,
+ * and most cameras never run object detection.
+ */
+public class TensorRtJNI {
+    private static final String LIB_PATH = "/usr/lib/libspectrumtrt.so";
+    private static boolean loaded = false;
+
+    /** Whether the TensorRT backend is installed (without loading it). */
+    public static boolean isInstalled() {
+        return new File(LIB_PATH).isFile();
+    }
+
+    /** Loads the native library; true if it's usable. */
+    public static synchronized boolean load() {
+        if (!loaded) {
+            try {
+                System.load(LIB_PATH);
+                loaded = true;
+            } catch (Throwable t) {
+                System.err.println("Could not load " + LIB_PATH + ": " + t);
+            }
+        }
+        return loaded;
+    }
+
+    /** Loads a TensorRT engine; 0 if it couldn't. */
+    public static native long create(String enginePath);
+
+    /** {width, height} of the engine's input tensor. */
+    public static native int[] inputSize(long ptr);
+
+    /**
+     * Runs the engine on a letterboxed BGR image (CV_8UC3, exactly the input size).
+     *
+     * @return flat [x, y, w, h, classId, confidence] per detection in letterboxed pixels, best
+     *     first; null on error
+     */
+    public static native float[] detect(
+            long ptr, long bgrMatPtr, double boxThresh, double nmsThresh, int numClasses);
+
+    public static native void destroy(long ptr);
+}
diff --git a/photon-core/src/main/java/org/photonvision/vision/objects/TensorRtModel.java b/photon-core/src/main/java/org/photonvision/vision/objects/TensorRtModel.java
