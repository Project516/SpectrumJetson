+/*
+ * SpectrumJetson: cap the isochronous bandwidth specific cameras reserve.
+ * Some MJPEG cameras request the largest alternate setting in every mode
+ * (e.g. 1bcf:28c5, the Thriftiest Cam: 3 x 1020 bytes per microframe, about
+ * 196 Mbps) while sending a fraction of it, so a USB 2.0 root port only fits
+ * two. Capping dwMaxPayloadTransferSize makes the driver pick a smaller
+ * alternate setting. Format: vid:pid:bytes[,vid:pid:bytes...], ids in hex.
+ */
+module_param_named(payload_cap, uvc_payload_cap_param, charp, 0444);
+MODULE_PARM_DESC(payload_cap, "Cap the max payload per interval: vid:pid:bytes[,...] (hex ids)");
 
